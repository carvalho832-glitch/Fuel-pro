rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A document in fuelpro_admins/{uid} may only be added from the
    // Firebase Console/Admin SDK, never by a browser.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && exists(/databases/$(database)/documents/fuelpro_admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/fuelpro_admins/$(request.auth.uid)).data.active == true;
    }
    function isAnonymous() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }
    function ownerRecord() {
      return request.auth != null && resource.data.ownerUid == request.auth.uid;
    }
    function validCity(city) {
      return city in ['ARARAQUARA', 'SAO JOSE DOS CAMPOS'];
    }
    function validReport(data) {
      return data.keys().hasAll([
          'ownerUid', 'cnpj', 'city', 'kind', 'stationName',
          'originalAddress', 'proposedAddress', 'notes',
          'createdAt', 'updatedAt', 'status', 'schemaVersion'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'cnpj', 'city', 'kind', 'stationName',
          'originalAddress', 'proposedAddress', 'notes',
          'createdAt', 'updatedAt', 'status', 'schemaVersion'
        ])
        && data.ownerUid is string
        && data.ownerUid == request.auth.uid
        && data.cnpj is string && data.cnpj.matches('^[0-9]{14}$')
        && validCity(data.city)
        && data.kind in ['confirmed', 'correction']
        && data.stationName is string && data.stationName.size() >= 2 && data.stationName.size() <= 130
        && data.originalAddress is string && data.originalAddress.size() >= 7 && data.originalAddress.size() <= 180
        && data.proposedAddress is string && data.proposedAddress.size() >= 7 && data.proposedAddress.size() <= 180
        && data.notes is string && data.notes.size() <= 280
        && data.status == 'pending'
        && data.schemaVersion == 1;
    }
    match /fuelpro_reports/{reportId} {
      // One record per anonymous account and CNPJ. Helps limit accidental
      // duplicates, but is NOT a complete anti-spam measure.
      allow create: if isAnonymous()
        && reportId == request.auth.uid + '_' + request.resource.data.cnpj
        && validReport(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // A motorist can read only their own submission. Only admins may list.
      // Reading a missing own document is necessary before first create.
      // Other anonymous users cannot read another UID's report.
      allow get: if isAdmin()
        || (isAnonymous() && reportId.matches('^' + request.auth.uid + '_[0-9]{14}$'));
      allow list: if isAdmin();

      // Anonymous sender can edit only pending data. Admin moderation
      // must use atomic batched update + append-only audit entry.
      allow update: if (isAnonymous() && ownerRecord()
          && resource.data.status == 'pending'
          && validReport(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && request.time > resource.data.updatedAt + duration.value(60, 's')
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['kind', 'proposedAddress', 'notes', 'updatedAt']))
        || (isAdmin()
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'reviewedBy', 'reviewedAt', 'reviewNote'])
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.reviewedBy == request.auth.uid
          && request.resource.data.reviewedAt == request.time
          && request.resource.data.reviewNote is string
          && request.resource.data.reviewNote.size() <= 500
          && getAfter(/databases/$(database)/documents/fuelpro_review_logs/$(reportId)).data.reportId == reportId
          && getAfter(/databases/$(database)/documents/fuelpro_review_logs/$(reportId)).data.status == request.resource.data.status
          && getAfter(/databases/$(database)/documents/fuelpro_review_logs/$(reportId)).data.reviewedBy == request.auth.uid
          && getAfter(/databases/$(database)/documents/fuelpro_review_logs/$(reportId)).data.reviewedAt == request.time);

      allow delete: if false;

    }
    match /fuelpro_review_logs/{reportId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['reportId', 'cnpj', 'status', 'reviewedBy', 'reviewedAt', 'reviewNote'])
        && request.resource.data.keys().hasOnly(['reportId', 'cnpj', 'status', 'reviewedBy', 'reviewedAt', 'reviewNote'])
        && request.resource.data.reportId == reportId
        && request.resource.data.cnpj is string
        && request.resource.data.cnpj.matches('^[0-9]{14}$')
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.reviewNote is string
        && request.resource.data.reviewNote.size() <= 500
        && getAfter(/databases/$(database)/documents/fuelpro_reports/$(reportId)).data.status == request.resource.data.status
        && getAfter(/databases/$(database)/documents/fuelpro_reports/$(reportId)).data.cnpj == request.resource.data.cnpj
        && getAfter(/databases/$(database)/documents/fuelpro_reports/$(reportId)).data.reviewedBy == request.auth.uid;
      allow update, delete: if false;
    }
    // A second, opt-in action. Public records contain NO anonymous UID.
    match /fuelpro_public_stations/{cnpj} {
      allow get: if true;
      allow list: if false;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'cnpj', 'city', 'stationName', 'address', 'kind',
          'status', 'publishedAt'
        ])
        && request.resource.data.cnpj == cnpj
        && request.resource.data.cnpj.matches('^[0-9]{14}$')
        && validCity(request.resource.data.city)
        && request.resource.data.stationName is string
        && request.resource.data.stationName.size() >= 2
        && request.resource.data.stationName.size() <= 130
        && request.resource.data.address is string
        && request.resource.data.address.size() >= 7
        && request.resource.data.address.size() <= 180
        && request.resource.data.kind == 'confirmed'
        && request.resource.data.status == 'community_confirmed'
        && request.resource.data.publishedAt == request.time
        && getAfter(/databases/$(database)/documents/fuelpro_publication_sources/$(cnpj)).data.publishedBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/fuelpro_publication_sources/$(cnpj)).data.publishedAt == request.time
        && getAfter(/databases/$(database)/documents/fuelpro_publication_sources/$(cnpj)).data.cnpj == cnpj;
      allow update, delete: if false;
    }
    // Private source stored in the same atomic commit as public notice.
    match /fuelpro_publication_sources/{cnpj} {
      function validSource() {
        let report = get(/databases/$(database)/documents/fuelpro_reports/$(request.resource.data.reportId)).data;
        let publicRecord = getAfter(/databases/$(database)/documents/fuelpro_public_stations/$(cnpj)).data;
        return report.cnpj == cnpj
          && report.status == 'approved'
          && report.kind == 'confirmed'
          && report.originalAddress == report.proposedAddress
          && publicRecord.cnpj == cnpj
          && publicRecord.city == report.city
          && publicRecord.stationName == report.stationName
          && publicRecord.address == report.originalAddress
          && publicRecord.kind == 'confirmed'
          && publicRecord.status == 'community_confirmed'
          && publicRecord.publishedAt == request.time;
      }
      allow get, list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'cnpj', 'reportId', 'publishedBy', 'publishedAt'
        ])
        && request.resource.data.cnpj == cnpj
        && request.resource.data.reportId is string
        && request.resource.data.publishedBy == request.auth.uid
        && request.resource.data.publishedAt == request.time
        && validSource();
      allow update, delete: if false;
    }
    match /fuelpro_admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
